<mxfile host="app.diagrams.net">
  <diagram name="Bootstrap Config Server" id="cfg-bootstrap">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="config-server — bootstrap de configuración" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="520" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ms" value="Microservicio&#10;(p.ej. account-service)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="160" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="cfg" value="ConfigServerApplication&#10;:8888" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="50" width="180" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="fs" value="Filesystem nativo&#10;src/main/resources/config/" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="200" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="spring.config.import&#10;optional:configserver:http://localhost:8888" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;" edge="1" parent="1" source="ms" target="cfg">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="180" as="sourcePoint"/>
            <mxPoint x="450" y="180" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="GET /{application}/default" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;" edge="1" parent="1" source="ms" target="cfg">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="260" as="sourcePoint"/>
            <mxPoint x="450" y="260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="lee YAML nativo&#10;(account-service.yml / application.yml)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;" edge="1" parent="1" source="cfg" target="fs">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="340" as="sourcePoint"/>
            <mxPoint x="780" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="contenido YAML" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;" edge="1" parent="1" source="fs" target="cfg">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="410" as="sourcePoint"/>
            <mxPoint x="450" y="410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="Environment / propiedades" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;" edge="1" parent="1" source="cfg" target="ms">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="480" as="sourcePoint"/>
            <mxPoint x="140" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
